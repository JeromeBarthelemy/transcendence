# Copy this file to `.env` and fill in the values. `.env` is never committed.

# Required, with no default: the project refuses to start without it.
# To generate one:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=

# true for local development. Never true on the club's machine.
DJANGO_DEBUG=true

# Host names served, comma-separated. `backend` is the service's name in
# compose.prod.yml, always present; add the machine's Wi-Fi address
# (e.g. 192.168.0.119) if students connect to it from their phones — see
# FIELDNOTES_HOST below.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

# Origins allowed to send POST requests, with their scheme. Same address as
# DJANGO_ALLOWED_HOSTS and FIELDNOTES_HOST, with https://.
DJANGO_CSRF_TRUSTED_ORIGINS=https://localhost

# Address at which the machine serving the application is reached over HTTPS
# (compose.prod.yml, deploy/Caddyfile): localhost if everything happens on
# the same computer, otherwise the machine's local Wi-Fi address so that
# students' phones can connect to it. A self-signed certificate is generated
# once for this address (see the cert-init service); changing it makes that
# certificate stale, and the tls_certs volume must be removed for a new one
# to be generated.
FIELDNOTES_HOST=localhost

# SMTP relay — needed for the GDPR module's confirmation emails.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=fieldnotes@example.org

# Domain of the addresses given to members who have none. It must stay under
# .invalid (RFC 2606): nothing must ever be deliverable there.
SIGNUP_RESERVED_EMAIL_DOMAIN=rouages.invalid

# Origin of the Vite development server. No effect outside DEBUG: in
# production the frontend is served behind the same proxy, hence same origin.
DJANGO_DEV_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Answer generation for the rulebook RAG (#135). `ollama` is the service's
# name in compose.yml; outside Docker (local venv), put your Ollama's address,
# for example http://localhost:11434. Changing models doesn't touch the code:
# the model only has to have been fetched (`ollama pull <model>`).
RAG_OLLAMA_URL=http://ollama:11434
RAG_GENERATION_MODEL=qwen2.5:3b
