# Copie ce fichier en `.env` et remplis les valeurs. `.env` n'est jamais versionné.

# Obligatoire, sans valeur par défaut : le projet refuse de démarrer sans.
# Pour en générer une :
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=

# true pour développer en local. Jamais à true sur la machine du club.
DJANGO_DEBUG=true

# Noms d'hôte servis, séparés par des virgules.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Origines autorisées pour les requêtes POST, avec leur schéma.
DJANGO_CSRF_TRUSTED_ORIGINS=https://localhost

# Relais SMTP — nécessaire aux courriels de confirmation du module RGPD.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=fieldnotes@example.org

# Domaine des adresses données aux membres qui n'en ont pas. Il doit rester en
# .invalid (RFC 2606) : rien ne doit pouvoir y être délivré.
SIGNUP_RESERVED_EMAIL_DOMAIN=rouages.invalid

# Origine du serveur de développement Vite. Sans effet hors DEBUG : en
# production le front est servi derrière le même proxy, donc même origine.
DJANGO_DEV_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
