# Copie ce fichier en `.env` et remplis les valeurs. `.env` n'est jamais versionné.

# Obligatoire, sans valeur par défaut : le projet refuse de démarrer sans.
# Pour en générer une :
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=

# true pour développer en local. Jamais à true sur la machine du club.
DJANGO_DEBUG=true

# Noms d'hôte servis, séparés par des virgules. `backend` est le nom du
# service dans compose.prod.yml, toujours présent ; ajoute l'adresse Wi-Fi
# du poste (ex. 192.168.0.119) si les élèves s'y connectent depuis leur
# téléphone — voir FIELDNOTES_HOST ci-dessous.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

# Origines autorisées pour les requêtes POST, avec leur schéma. Même
# adresse que DJANGO_ALLOWED_HOSTS et FIELDNOTES_HOST, avec https://.
DJANGO_CSRF_TRUSTED_ORIGINS=https://localhost

# Adresse à laquelle le poste qui sert l'application est joint en HTTPS
# (compose.prod.yml, deploy/Caddyfile) : localhost si tout se passe sur le
# même ordinateur, sinon l'adresse Wi-Fi locale du poste pour que les
# téléphones des élèves puissent s'y connecter. Un certificat auto-signé
# est généré une fois pour cette adresse (voir le service cert-init) ; la
# changer en périme un et il faut supprimer le volume tls_certs pour
# qu'elle en régénère un nouveau.
FIELDNOTES_HOST=localhost

# Relais SMTP — nécessaire aux courriels de confirmation du module RGPD.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=fieldnotes@example.org

# Domaine des adresses données aux membres qui n'en ont pas. Il doit rester en
# .invalid (RFC 2606) : rien ne doit pouvoir y être délivré.
SIGNUP_RESERVED_EMAIL_DOMAIN=rouages.invalid

# Origine du serveur de développement Vite. Sans effet hors DEBUG : en
# production le front est servi derrière le même proxy, donc même origine.
DJANGO_DEV_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Génération des réponses du RAG règlement (#135). `ollama` est le nom du
# service dans compose.yml ; hors Docker (venv local), mets l'adresse de ton
# Ollama, par exemple http://localhost:11434. Changer de modèle ne touche
# pas au code : il doit juste avoir été récupéré (`ollama pull <modèle>`).
RAG_OLLAMA_URL=http://ollama:11434
RAG_GENERATION_MODEL=qwen3:4b-instruct-2507-q4_K_M
